---
import { getCollection, render } from "astro:content";
import { useTranslations, type Locale } from "../../i18n";
import { buildDocRegistry, getAdjacentDocs, getDocEntry, buildTocGroups, getProjectVersions, getDocCategoryTabs, filterRegistryByCategory } from "../../utils/docs";
import DocShell from "./DocShell.astro";

interface Props {
    slug: string;
    docId: string;
    locale: Locale;
    version?: string;
}
const { slug: projectSlug, docId, locale, version } = Astro.props;
const t = useTranslations(locale);
const prefix = locale === "zh-cn" ? "" : `/${locale}`;
const versionPrefix = version && version !== 'alpha' ? `/${version}` : '';

const registry = await buildDocRegistry(projectSlug, locale, version);
const docEntry = await getDocEntry(docId, locale);
if (!docEntry) return new Response('Not Found', { status: 404 });

// 根别名路径（如 /projects/texturge/tutorials/...）下，registry 中的 doc.id 包含版本段
// （如 texturge/beta/tutorials/...），但 URL 中的 docId 不含版本段。归一化 registry
// 中的 ID 使其匹配根别名的 URL 格式，避免侧边栏链接 302 跳转和分类选项卡回退。
const versionInfo = await getProjectVersions(projectSlug);
if (!version && versionInfo) {
    const verPrefix = `${projectSlug}/${versionInfo.currentVersion}/`;
    const rootPrefix = `${projectSlug}/`;
    registry.chapters.forEach(ch => {
        ch.docs.forEach(doc => { doc.id = doc.id.replace(verPrefix, rootPrefix); });
    });
    registry.flatList.forEach(doc => { doc.id = doc.id.replace(verPrefix, rootPrefix); });
}

const { Content, headings } = await render(docEntry);
const tocGroups = buildTocGroups(headings);
const adj = getAdjacentDocs(registry.flatList, docId);
const currentDoc = registry.flatList.find((d) => d.id === docId);
const pageTitle = currentDoc?.title ?? docEntry.data.title;
const pageDescription = docEntry.data.excerpt;

// 项目展示名：取项目索引 frontmatter title 中 "—" 之前的部分
// （如 "Texturge Pro" / "CLIF Localization Suite"），回退到 slug 首字母大写。
// 站点承载多个插件文档，展示名必须随项目变化，不能硬编码某一个插件名。
const allProjects = await getCollection("projects", ({ data }: any) => !data.draft);
const indexBaseIds = new Set([
    `${projectSlug}/${projectSlug}`,
    `${projectSlug}/index`,
    `${projectSlug}/${versionInfo?.currentVersion}/${projectSlug}`,
    `${projectSlug}/${versionInfo?.currentVersion}/index`,
]);
const projectIndexEntry = allProjects.find((p) =>
    indexBaseIds.has(p.id.replace(/\.(en-us|ja-jp|ko-kr|ar-sa|es-es|fr-fr|pt-pt|ru-ru|de-de)$/, "")),
);
const docTitle =
    (projectIndexEntry?.data.title ?? projectSlug).split("—")[0].trim() ||
    projectSlug.charAt(0).toUpperCase() + projectSlug.slice(1);
const docDescription = pageDescription || `${pageTitle} — ${docTitle} 文档页面`;

const pager = {
    prev: adj.prev ? { id: adj.prev.id, title: adj.prev.title } : null,
    next: adj.next ? { id: adj.next.id, title: adj.next.title } : null,
};

// 分类选项卡
const tabs = getDocCategoryTabs();
const activeTabRaw = currentDoc?.category || 'guides';
const activeTab = activeTabRaw === 'tutorials' ? 'tutorial' : activeTabRaw;
const allRegistries: Record<string, import("../../utils/docs").DocRegistry> = {};
for (const tab of tabs) {
    allRegistries[tab.slug] = filterRegistryByCategory(registry, tab.slug);
}
const filteredRegistry = allRegistries[activeTab] || registry;
---

<DocShell
    locale={locale}
    projectSlug={projectSlug}
    pageTitle={pageTitle}
    pageSeoTitle={`${pageTitle} — ${docTitle} | ${t('site-title')}`}
    description={pageDescription}
    seoDescription={docDescription}
    ogImage={`/og-${projectSlug}.png`}
    registry={filteredRegistry}
    allRegistries={allRegistries}
    tabs={tabs}
    activeTab={activeTab}
    projectTitle={docTitle}
    tocGroups={tocGroups}
    activeDocId={docId}
    pager={pager}
    versions={versionInfo?.versions}
    versionNames={versionInfo?.versionNames}
    currentVersion={versionInfo?.currentVersion}
    activeVersion={version}
>
    <Fragment slot="before-content">
        {currentDoc && !currentDoc.isIndex && (
            <nav class="doc-breadcrumb">
                <a href={`${prefix}/projects/${projectSlug}${versionPrefix}/`}>
                    <i class="bx bx-book-open" /> {t("projects-docs-overview")}
                </a>
                <span class="doc-breadcrumb-sep">/</span>
                {(() => {
                    const chapterTitleKey = registry.chapters.find((c) => c.slug === currentDoc.chapterSlug)?.titleKey;
                    const chapterLabel = chapterTitleKey && t(chapterTitleKey) !== chapterTitleKey
                        ? t(chapterTitleKey)
                        : currentDoc.chapterSlug.replace(/-/g, " ");
                    return <span>{chapterLabel}</span>;
                })()}
            </nav>
        )}
    </Fragment>
    <Content />
</DocShell>

<script>
  import { initTocSlider } from '../../scripts/toc-slider';
  import { initLightbox } from '../../scripts/lightbox';

  function init() {
    initTocSlider();
    initLightbox();
  }

  document.addEventListener('astro:page-load', init);
  // 在视图过渡捕获新页面前初始化 TOC 滑块，防止闪烁和跳变
  document.addEventListener('astro:after-swap', () => { initTocSlider(); });
</script>
