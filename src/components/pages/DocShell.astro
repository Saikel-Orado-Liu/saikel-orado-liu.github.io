---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { Locale } from "../../i18n";
import type { DocRegistry, DocCategoryTab } from "../../utils/docs";
import "../../styles/doc-shared.css";
import VersionWheel from "../doc/VersionWheel.astro";
import TocCard from "../doc/TocCard.astro";
import DocTree from "../doc/DocTree.astro";
import DocPager from "../doc/DocPager.astro";

interface Props {
  locale: Locale;
  projectSlug: string;
  pageTitle: string;
  pageSeoTitle?: string;
  description?: string;
  seoDescription?: string;
  ogImage?: string;
  projectTitle: string;
  registry: DocRegistry;
  allRegistries: Record<string, DocRegistry>;
  tabs: DocCategoryTab[];
  activeTab: string;
  tocGroups: { h2: any; h3s: any[] }[];
  activeDocId?: string;
  activeSidebarLink?: string;
  pager?: { prev: { id: string; title: string } | null; next: { id: string; title: string } | null };
  emptyPrevText?: string;
  emptyNextText?: string;
  versions?: string[];
  versionNames?: Record<string, string>;
  currentVersion?: string;
  activeVersion?: string;
}

const {
  locale,
  projectSlug,
  pageTitle,
  pageSeoTitle,
  description,
  seoDescription,
  ogImage,
  projectTitle = "",
  registry,
  allRegistries,
  tabs,
  activeTab,
  tocGroups,
  activeDocId,
  activeSidebarLink,
  pager,
  emptyPrevText = "已是最前",
  emptyNextText = "已是最后",
  versions,
  versionNames,
  currentVersion,
  activeVersion,
} = Astro.props;
const prefix = locale === "zh-cn" ? "" : `/${locale}`;
const showWheel = versions && versions.length > 1;
const homeSeg = activeVersion ? "/" + activeVersion : "";
const docHomeHref = prefix + "/projects/" + projectSlug + homeSeg + "/";
---

<BaseLayout
  title={pageTitle}
  seoTitle={pageSeoTitle}
  description={description}
  seoDescription={seoDescription}
  ogImage={ogImage}
  locale={locale}
  docMode={true}
  docTitle={projectTitle}
  docIcon="https://avatars.githubusercontent.com/u/88531138"
  docHomeHref={docHomeHref}
>
    <div class="doc-layout">
        <aside class="doc-sidebar doc-sidebar-left">
            <DocTree
              locale={locale}
              projectSlug={projectSlug}
              activeVersion={activeVersion}
              registry={registry}
              allRegistries={allRegistries}
              activeDocId={activeDocId}
              activeSidebarLink={activeSidebarLink}
              tabs={tabs}
              activeTab={activeTab}
            />
        </aside>

        <main class="doc-main">
            <slot name="before-content" />
            <div class="article-content"><slot /></div>
            {pager && <DocPager locale={locale} prefix={prefix} pager={pager} emptyPrevText={emptyPrevText} emptyNextText={emptyNextText} />}
        </main>

        {(showWheel || tocGroups.length > 0) && (
            <aside class="doc-sidebar doc-sidebar-right">
                {showWheel && <VersionWheel locale={locale} versions={versions!} versionNames={versionNames} currentVersion={currentVersion!} activeVersion={activeVersion} projectSlug={projectSlug} prefix={prefix} />}
                <TocCard locale={locale} tocGroups={tocGroups} />
            </aside>
        )}
    </div>
</BaseLayout>

<script>
    function updateSidebarHeight() {
        document.querySelectorAll<HTMLElement>('.doc-sidebar').forEach(function(s) {
            s.style.maxHeight = 'calc(100vh - ' + s.getBoundingClientRect().top + 'px - var(--space-lg))';
        });
    }

    function updateMask(w: HTMLElement) {
        var hasOverflow = w.scrollHeight > w.clientHeight + 1;
        if (!hasOverflow) {
            w.style.setProperty('-webkit-mask-image', 'none');
            w.style.maskImage = 'none';
            return;
        }
        var topDist = Math.min(Math.max(0, w.scrollTop - 5), 30);
        var bottomDist = Math.min(Math.max(0, w.scrollHeight - w.scrollTop - w.clientHeight - 5), 30);
        var mask;
        if (topDist <= 0 && bottomDist <= 0) {
            mask = 'none';
        } else if (bottomDist <= 0) {
            mask = 'linear-gradient(to bottom, transparent 0%, black ' + topDist + 'px, black 100%)';
        } else if (topDist <= 0) {
            mask = 'linear-gradient(to bottom, black 0%, black calc(100% - ' + bottomDist + 'px), transparent 100%)';
        } else {
            mask = 'linear-gradient(to bottom, transparent 0%, black ' + topDist + 'px, black calc(100% - ' + bottomDist + 'px), transparent 100%)';
        }
        w.style.setProperty('-webkit-mask-image', mask);
        w.style.maskImage = mask;
    }

    function initScrollOverflowMask() {
        document.querySelectorAll<HTMLElement>('.doc-scroll-wrapper').forEach(function(w) {
            if (w.dataset.maskReady === 'true') return;
            w.dataset.maskReady = 'true';

            w.addEventListener('scroll', function() { updateMask(w); }, { passive: true });
            new ResizeObserver(function() { updateMask(w); }).observe(w);
            updateMask(w);
        });
    }

    function initAll() {
        initScrollOverflowMask();
        updateSidebarHeight();
    }

    window.addEventListener('scroll', updateSidebarHeight, { passive: true });
    window.addEventListener('resize', updateSidebarHeight, { passive: true });

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAll, { once: true });
    } else {
        initAll();
    }
    document.addEventListener('astro:page-load', function() {
        document.querySelectorAll<HTMLElement>('.doc-scroll-wrapper').forEach(function(w) {
            delete w.dataset.maskReady;
        });
        initAll();
    });
</script>
